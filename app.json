{
  "expo": {
    "name": "VitaRogue",
    "slug": "VitaRogue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "GOOGLE_PLACES_API_KEY": "AIzaSyAew3jRMeVFelmj0fT0EoRVCN0McIVquAA",
      "GEMINI_API_KEY": "AIzaSyBYk-O6RFxd5zZfGXaTXnXoiE-r1htaNgQ",
  "EXPO_PUBLIC_VITABOT_PROXY_URL": "",
      "eas": {
        "projectId": "96e37541-8b98-4aa7-91a2-acc5b006c78e"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find nearby gyms.",
        "NSCameraUsageDescription": "Allow VitaRogue to access your camera to scan and identify food items for nutrition tracking.",
        "NSPhotoLibraryUsageDescription": "Allow VitaRogue to access your photos to identify food items from your gallery.",
        "NSMicrophoneUsageDescription": "This app does not require microphone access."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAew3jRMeVFelmj0fT0EoRVCN0McIVquAA"
      },
      "bundleIdentifier": "com.everboltit.VitaRogue"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/main-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAew3jRMeVFelmj0fT0EoRVCN0McIVquAA"
        }
      },
      "package": "com.everboltit.VitaRogue"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VitaRogue to access your camera to scan and identify food items for nutrition tracking.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VitaRogue to access your photos to identify food items from your gallery."
        }
      ]
    ]
  }
}