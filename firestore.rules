rules_version = '2';

// Hardened Firestore security rules (least-privilege baseline)
// Adjust as your data model evolves. These remove the blanket open rule that was expiring.
// Key collections currently referenced in code: users, coaches, chats, chats/{chatId}/messages, (weights subcollection under users)
// Principle: A user may fully manage ONLY their own user document (same UID) and its direct subcollections (e.g., weights).
// Coaches follow same rule under coaches collection (doc id = auth.uid). Public readable coach listing allowed for discovery.
// Chats are readable/writable only to participants listed in participants[] array.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- USERS ----
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow any authenticated user to read user profiles (temporary for development)
      allow read: if request.auth != null;

      // Example subcollections (e.g., weights, preferences). Inherit same owner rule.
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Explicit nutrition plans subcollection (assigned plans)
      match /nutritionPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---- COACHES ----
    match /coaches/{coachId} {
      // Anyone may read a coach profile (public marketplace). Limit fields in document to non-sensitive info.
      allow read: if true;
      // Only the coach themselves can create/update their doc.
      allow create, update, delete: if request.auth != null && request.auth.uid == coachId;
      // Coach-owned nutrition templates
      match /nutritionTemplates/{templateId} {
        allow read: if request.auth != null; // any authenticated user can view template summaries
        allow create, update, delete: if request.auth != null && request.auth.uid == coachId;
      }
    }

    // ---- SESSIONS ----
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.coachId || request.auth.uid == resource.data.clientId);
      allow create: if request.auth != null && request.resource.data.coachId == request.auth.uid && request.resource.data.clientId is string;
      allow update: if request.auth != null && request.auth.uid == resource.data.coachId;
      allow delete: if false; // prevent deletes; use status cancellation
    }

    // ---- CHATS ROOT ----
    match /chats/{chatId} {
      // Only participants can read or write the chat document.
  allow read: if isParticipant(resource.data.participants);
  allow create: if request.auth != null && isParticipant(request.resource.data.participants)
        && request.resource.data.participants.size() == 2
        && validateNewChat(request.resource.data);
  allow update: if isParticipant(resource.data.participants)
        && validateChatUpdate(request.resource.data, resource.data);
  allow delete: if false; // disallow deletes via client (optional hardening)

      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        // No direct update/delete of messages for now (immutability); adjust if editing needed.
      }
    }

    // ---- NOTIFICATIONS ----
    match /notifications/{notificationId} {
      // Users can read their own notifications and create notifications for others
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }

    // ---- USER COACH RELATIONSHIPS ----
    match /UserCoachRelationships/{relationshipId} {
      // Allow coaches to create relationships when accepting requests
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.coach.id;
      
      // Allow both coach and client to read their relationships
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.coach.id || 
         request.auth.uid == resource.data.client.id);
      
      // Allow both coach and client to update their relationships
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.coach.id || 
         request.auth.uid == resource.data.client.id);
      
      // Allow coaches to delete relationships
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.coach.id;
    }

    // ---- COACH CLIENT RELATIONSHIPS (Legacy) ----
    match /coachClientRelationships/{relationshipId} {
      // Both coach and client can read the relationship
      allow read: if request.auth != null && (request.auth.uid == resource.data.coachId || request.auth.uid == resource.data.clientId);
      // Only coaches can create relationships (when accepting requests)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.coachId;
      // Both can update (e.g., to end relationship)
      allow update: if request.auth != null && (request.auth.uid == resource.data.coachId || request.auth.uid == resource.data.clientId);
      // Allow coaches to delete their relationships (for testing and management)
      allow delete: if request.auth != null && (request.auth.uid == resource.data.coachId || request.auth.uid == resource.data.clientId);
      // Allow coaches to delete any relationship for testing purposes (temporary)
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    // ---- FUNCTIONS ----
    // Add future secured collections here (e.g., admin, analytics) with explicit rules.

    // Utility function: check participant membership
    function isParticipant(participants) {
      return request.auth != null && participants != null && participants.hasAny([request.auth.uid]);
    }

    function hasFields(data, fieldList) {
      return fieldList.hasAll(fieldList);
    }

    function validateLastMessage(msg) {
      return msg == null || (
        msg.keys().hasOnly(['text','senderId','timestamp']) &&
        (msg.text is string) && (msg.senderId is string)
      );
    }

    function validateUnread(unread) {
      return unread is map;
    }

    function validateParticipants(p) { return p is list && p.size() == 2; }

    function validateNewChat(data) {
      return validateParticipants(data.participants)
             && validateUnread(data.unreadCount)
             && validateLastMessage(data.lastMessage);
    }

    function validateChatUpdate(newData, oldData) {
      // Allow server (functions) to add lastReadAt / update counts / lastMessage / updatedAt only.
      // Participants immutable.
      // Permit optional 'typing' map<string,bool>
      return newData.participants == oldData.participants
             && validateUnread(newData.unreadCount)
             && validateLastMessage(newData.lastMessage)
             && (newData.typing == null || newData.typing is map);
    }

    // ---- ANALYTICS ----
    match /analytics/{coachId} {
      allow read: if request.auth != null && request.auth.uid == coachId; // private to coach
      allow create, update: if request.auth != null && request.auth.uid == coachId;
      allow delete: if false;
    }
  }
}
